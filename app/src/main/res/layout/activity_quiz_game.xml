<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context="Game.QuizGame">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top bar: timer + score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_timer"
                     />

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30s"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>



            <ImageView
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_star"
                app:tint="@color/brand_orange" />

            <TextView
                android:visibility="gone"
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 0"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_20sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/questionCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="1/10"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="10"
                android:progressDrawable="@drawable/progress_track" />

            <TextView
                android:id="@+id/progressPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="10%"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Question card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/questionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingVertical="28dp">

                <TextView
                    android:id="@+id/questionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_badge_orange"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:text="Q1"
                    android:textColor="@color/brand_orange_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="What is the capital of France? "
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Option A -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionA"
            style="@style/OptionCard">

            <LinearLayout style="@style/OptionInner">
                <TextView style="@style/OptionLetter" android:text="A" />
                <TextView android:id="@+id/optionAText" style="@style/OptionText" android:text="Paris" />
                <ImageView android:id="@+id/optionAIcon" style="@style/OptionIcon" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Option B -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionB"
            style="@style/OptionCard">

            <LinearLayout style="@style/OptionInner">
                <TextView style="@style/OptionLetter" android:text="B" />
                <TextView android:id="@+id/optionBText" style="@style/OptionText" android:text="London" />
                <ImageView android:id="@+id/optionBIcon" style="@style/OptionIcon" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Option C -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionC"
            style="@style/OptionCard">

            <LinearLayout style="@style/OptionInner">
                <TextView style="@style/OptionLetter" android:text="C" />
                <TextView android:id="@+id/optionCText" style="@style/OptionText" android:text="Berlin" />
                <ImageView android:id="@+id/optionCIcon" style="@style/OptionIcon" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Option D -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionD"
            style="@style/OptionCard"
            android:layout_marginBottom="20dp">

            <LinearLayout style="@style/OptionInner">
                <TextView style="@style/OptionLetter" android:text="D" />
                <TextView android:id="@+id/optionDText" style="@style/OptionText" android:text="Madrid" />
                <ImageView android:id="@+id/optionDIcon" style="@style/OptionIcon" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Next button -->
        <com.google.android.material.button.MaterialButton
            android:layout_marginTop="@dimen/_30sdp"
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:text="@string/next_question"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_orange"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="end"
            app:iconTint="@color/white" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>