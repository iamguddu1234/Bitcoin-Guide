<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".Game.ResultActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Score header card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/scoreCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_20sdp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/_20sdp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingVertical="@dimen/_15sdp">

                <FrameLayout
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:background="@drawable/bg_circle_orange_light">

                    <ImageView
                        android:id="@+id/achievementIcon"
                        android:layout_width="@dimen/_55sdp"
                        android:layout_height="@dimen/_55sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_trophy_gold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtCongratulations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/congratulations"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPerformanceMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="@string/excellent_performance"
                    android:textAlignment="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtFinalScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8/10"
                    android:textColor="@color/brand_orange"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="80%"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Stats row -->
        <LinearLayout
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_20sdp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView style="@style/StatCard" android:layout_marginEnd="6dp">
                <LinearLayout style="@style/StatInner">
                    <ImageView style="@style/StatIcon" android:src="@drawable/ic_check_circle" app:tint="@color/correct_green" />
                    <TextView android:id="@+id/txtCorrectAnswers" style="@style/StatValue" android:text="8" />
                    <TextView style="@style/StatLabel" android:text="@string/correct_answers" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView style="@style/StatCard" android:layout_marginHorizontal="6dp">
                <LinearLayout style="@style/StatInner">
                    <ImageView style="@style/StatIcon" android:src="@drawable/ic_close_circle" app:tint="@color/wrong_red" />
                    <TextView android:id="@+id/txtWrongAnswers" style="@style/StatValue" android:text="2" />
                    <TextView style="@style/StatLabel" android:text="@string/wrong_answers" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView style="@style/StatCard" android:layout_marginStart="6dp">
                <LinearLayout style="@style/StatInner">
                    <ImageView style="@style/StatIcon" android:src="@drawable/ic_timer" app:tint="@color/time_amber" />
                    <TextView android:id="@+id/txtTimeTaken" style="@style/StatValue" android:text="4:32" />
                    <TextView style="@style/StatLabel" android:text="@string/time_taken" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Improvement strip -->
        <LinearLayout
            android:id="@+id/comparisonCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_20sdp"
            android:background="@drawable/bg_strip_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_trending_up"
                app:tint="@color/correct_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtImprovement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/improved_by_2_points"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPreviousScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/previous_best"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_marginTop="@dimen/_20sdp"
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayAgain"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/play_again"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_orange"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHome"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/back_to_home"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_home"
                app:iconGravity="textStart"
                app:iconTint="@color/text_secondary"
                app:strokeColor="@color/border_color"
                app:strokeWidth="2dp" />
        </LinearLayout>



    </LinearLayout>
</androidx.core.widget.NestedScrollView>