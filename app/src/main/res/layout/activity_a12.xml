<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".Advance.A12">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp"
                app:strokeColor="#ECECF2"
                app:strokeWidth="0.9dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Level chip -->
                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:text="Basic level"
                        android:textColor="#1A56DB"
                        android:textSize="@dimen/_10ssp"
                        app:chipBackgroundColor="#E8F0FE"
                        app:chipIcon="@drawable/ic_layers"
                        app:chipIconTint="#1A56DB"
                        app:chipMinHeight="@dimen/_28sdp"
                        app:chipStrokeColor="#C3D3FB"
                        app:chipStrokeWidth="0.5dp"
                        app:rippleColor="@android:color/transparent" />

                    <!-- Divider -->
                    <View
                        android:layout_width="0.8dp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:background="#E5E7EB" />

                    <LinearLayout

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <!-- Read time -->
                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:src="@drawable/ic_clock"
                            app:tint="#6B7280" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:fontFamily="@font/roboto_medium"
                            android:text="8 min read"
                            android:textColor="#6B7280"
                            android:textSize="@dimen/_10ssp" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="0.8dp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:background="#E5E7EB" />

                    <!-- Difficulty chip -->
                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:text="Beginner"
                        android:textColor="#92400E"
                        android:textSize="@dimen/_10ssp"
                        app:chipBackgroundColor="#FEF3C7"
                        app:chipIcon="@drawable/ic_star"
                        app:chipIconTint="#92400E"
                        app:chipMinHeight="@dimen/_28sdp"
                        app:chipStrokeColor="#FDE68A"
                        app:chipStrokeWidth="0.5dp"
                        app:rippleColor="@android:color/transparent" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                app:cardBackgroundColor="#000"
                app:cardCornerRadius="@dimen/_20sdp"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/_8sdp"
                app:strokeColor="#000"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_200sdp"
                    android:orientation="vertical">

                    <com.github.chrisbanes.photoview.PhotoView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="fitCenter"
                        android:src="@drawable/cloudmining" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:background="@drawable/backnew"
                android:fontFamily="@font/roboto"
                android:lineHeight="@dimen/_20sdp"

                android:text="@string/ac2"
                android:textAllCaps="false"
                android:textColor="@color/titletextColor"
                android:textSize="@dimen/_12ssp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="@dimen/_4sdp"
                app:cardElevation="@dimen/_2sdp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_8sdp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/_6sdp"
                            android:layout_height="@dimen/_6sdp"
                            app:cardBackgroundColor="@color/black"
                            app:cardCornerRadius="@dimen/_1sdp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp" android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:fontFamily="@font/roboto_medium"
                            android:includeFontPadding="false"
                            android:lineHeight="@dimen/_20sdp"
                            android:text="@string/ac3"
                            android:textColor="@color/titletextColor"
                            android:textSize="@dimen/_12ssp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="@dimen/_2sdp"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:background="@color/lightText" />

                    <TextView
                        android:id="@+id/subtitle1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_22sdp"
                        android:text="@string/ac4"
                        android:textColor="@color/titletextColor"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_22sdp"
                        android:text="@string/ac5"
                        android:textColor="@color/titletextColor"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_22sdp"
                        android:text="@string/ac6"
                        android:textColor="@color/titletextColor"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:lineHeight="@dimen/_22sdp"
                        android:text="@string/ac7"
                        android:textColor="@color/titletextColor"
                        android:textSize="@dimen/_12ssp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@color/card"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/ac8"
                android:textAllCaps="false"
                android:textColor="@color/titletextColor"
                android:textSize="@dimen/_14ssp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/a12rec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="1"
                tools:listitem="@layout/two_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@color/card"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/ac15"
                android:textAllCaps="false"
                android:textColor="@color/titletextColor"
                android:textSize="@dimen/_14ssp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/a12reci"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="1"
                tools:listitem="@layout/two_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_60sdp"
                android:background="@drawable/backnew"
                android:fontFamily="@font/roboto"
                android:lineHeight="@dimen/_20sdp"

                android:text="@string/ac26"
                android:textAllCaps="false"
                android:textColor="@color/titletextColor"
                android:textSize="@dimen/_12ssp" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <com.google.android.gms.ads.AdView

            android:id="@+id/adViewa12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            ads:adUnitId="@string/banner_id_admob" />

    </FrameLayout>

</RelativeLayout>