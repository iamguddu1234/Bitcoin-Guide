<?xml version="1.0" encoding="utf-8"?>
<!-- Bordered rounded background for Rate / Share / Dark mode / About buttons.
     Uses a selector so the border turns orange when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <solid android:color="@color/surface_white" />
            <stroke
                android:width="1dp"
                android:color="@color/brand_primary" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <solid android:color="@color/surface_white" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke_neutral" />
        </shape>
    </item>
</selector>