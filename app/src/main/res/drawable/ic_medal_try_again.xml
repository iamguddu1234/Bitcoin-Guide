    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Medal Base (Grey Circle) -->
    <path
        android:fillColor="#9E9E9E"
        android:pathData="M60,10 a50,50 0 1,1 0,100 a50,50 0 1,1 0,-100"
        android:strokeColor="#757575"
        android:strokeWidth="2"/>

    <!-- Inner Circle -->
    <path
        android:fillColor="#EEEEEE"
        android:pathData="M60,20 a40,40 0 1,1 0,80 a40,40 0 1,1 0,-80"/>

    <!-- Arrow Circle (Try Again Symbol) -->
    <group
        android:pivotX="60"
        android:pivotY="60"
        android:rotation="-90">
        <path
            android:fillColor="#616161"
            android:pathData="M60,40 L75,55 L65,55 L65,75 L55,75 L55,55 L45,55 Z"/>
    </group>

    <!-- Crack Effect -->
    <path
        android:strokeColor="#B71C1C"
        android:strokeWidth="1.5"
        android:pathData="M45,45 Q55,55 65,45"/>
    <path
        android:strokeColor="#B71C1C"
        android:strokeWidth="1.5"
        android:pathData="M75,75 Q65,65 75,55"/>

    <!-- Dull Shine -->
    <path
        android:fillColor="#30FFFFFF"
        android:pathData="M30,30 L40,20 L50,30 L40,40 Z"/>
</vector>