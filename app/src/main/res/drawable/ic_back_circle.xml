<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/ic_back_circle.xml -->
<!-- Combined layer-list: grey circle background + back arrow, for use directly as ActionBar back icon -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke android:color="#F0EAEA"/>
            <stroke android:width="0.3dp"/>

        </shape>
    </item>

    <item
        android:width="@dimen/_30sdp"
        android:height="@dimen/_30sdp"
        android:gravity="center"
        >


        <!-- res/drawable/ic_back_short.xml -->
        <!-- Square viewport (required for ActionBar) - arrow size increased slightly -->
        <vector xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">

            <path
                android:strokeColor="#333333"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:fillColor="@android:color/transparent"
                android:pathData="M16,16L9,12L16,8" />

        </vector>
    </item>

</layer-list>